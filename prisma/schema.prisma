generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  ACCOUNTANT
  PARENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(ADMIN)
  campusId  String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  children            Student[]            @relation("ParentStudents")
  teacherAssignments  TeacherAssignment[]
  assignments         Assignment[]
}

model Page {
  id        String   @id @default(cuid())
  campusId  String   @default("default")
  slug      String   @unique
  title     String
  content   String   @db.Text    // HTML content (sanitized)
  metaDescription String?
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Add to existing enums
enum Gender {
  MALE
  FEMALE
  OTHER
}

model Class {
  id        String    @id @default(cuid())
  campusId  String    @default("default")
  name      String    // e.g. "Nursery", "Class 1"
  students  Student[]
  feeStructures  FeeStructure[]     
  exams     Exam[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@unique([campusId, name])
  teacherAssignments TeacherAssignment[]
  assignments        Assignment[]

}

model Student {
  id              String    @id @default(cuid())
  campusId        String    @default("default")
  admissionNumber String?
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  classId         String?
  class           Class?    @relation(fields: [classId], references: [id])
  rollNumber      String?
  guardianName    String?
  guardianPhone   String?
  guardianEmail   String?
  address         String?
  photoUrl        String?   // Cloudinary URL
  feeVouchers     FeeVoucher[]  
  attendances     Attendance[]
  marks           Mark[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  parentId    String?
  parent      User?              @relation("ParentStudents", fields: [parentId], references: [id])
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Admission {
  id              String          @id @default(cuid())
  campusId        String          @default("default")
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  desiredClass    String?         // not yet a Class relation, just a string
  guardianName    String
  guardianPhone   String
  guardianEmail   String?
  address         String?
  status          AdmissionStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model FeeStructure {
  id        String   @id @default(cuid())
  campusId  String   @default("default")
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  feeType   String   // e.g. "Tuition", "Transport"
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, classId, feeType])
}

model FeeVoucher {
  id         String    @id @default(cuid())
  campusId   String    @default("default")
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  month      Int       // 1–12
  year       Int
  totalAmount Float
  isPaid     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  payments   Payment[]

  @@unique([campusId, studentId, month, year])
}

model Payment {
  id          String    @id @default(cuid())
  campusId    String    @default("default")
  voucherId   String
  voucher     FeeVoucher @relation(fields: [voucherId], references: [id])
  amount      Float
  method      String    @default("Cash") // Cash, Online, etc.
  receivedBy  String?   // user ID maybe later
  paidAt      DateTime  @default(now())
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id         String           @id @default(cuid())
  campusId   String           @default("default")
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  date       DateTime         @db.Date   // store only date part
  status     AttendanceStatus
  method     String           @default("MANUAL")   // MANUAL, CSV, QR
  recordedBy String?          // user ID of teacher
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([campusId, studentId, date])
}

model Subject {
  id        String   @id @default(cuid())
  campusId  String   @default("default")
  name      String
  code      String?  // optional short code

  examSubjects ExamSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, name])
}

model Exam {
  id        String   @id @default(cuid())
  campusId  String   @default("default")
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  name      String   // e.g., "Midterm 2026"
  date      DateTime @db.Date
  type      String   @default("Midterm") // "Midterm", "Final", etc.

  examSubjects ExamSubject[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ExamSubject {
  id        String  @id @default(cuid())
  examId    String
  exam      Exam   @relation(fields: [examId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  maxMarks  Float

  marks     Mark[]

  @@unique([examId, subjectId])
}

model Mark {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  obtainedMarks Float

  @@unique([studentId, examSubjectId])
}

model TeacherAssignment {
  id        String   @id @default(cuid())
  campusId  String   @default("default")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, classId])
}

model Assignment {
  id        String      @id @default(cuid())
  campusId  String      @default("default")
  classId   String?
  class     Class?      @relation(fields: [classId], references: [id])
  createdBy String
  creator   User        @relation(fields: [createdBy], references: [id])
  title     String
  content   String?
  type      String      @default("ANNOUNCEMENT")   // "ANNOUNCEMENT" or "HOMEWORK"
  dueDate   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}