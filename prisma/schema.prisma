generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  ACCOUNTANT
  PARENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(ADMIN)
  campusId  String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  campusId  String   @default("default")
  slug      String   @unique
  title     String
  content   String   @db.Text    // HTML content (sanitized)
  metaDescription String?
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Add to existing enums
enum Gender {
  MALE
  FEMALE
  OTHER
}

model Class {
  id        String    @id @default(cuid())
  campusId  String    @default("default")
  name      String    // e.g. "Nursery", "Class 1"
  students  Student[]
  feeStructures  FeeStructure[]     // ← ADD THIS

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@unique([campusId, name])

}

model Student {
  id              String    @id @default(cuid())
  campusId        String    @default("default")
  admissionNumber String?
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  classId         String?
  class           Class?    @relation(fields: [classId], references: [id])
  rollNumber      String?
  guardianName    String?
  guardianPhone   String?
  guardianEmail   String?
  address         String?
  photoUrl        String?   // Cloudinary URL
  feeVouchers     FeeVoucher[]   // ← ADD THIS

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Admission {
  id              String          @id @default(cuid())
  campusId        String          @default("default")
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  desiredClass    String?         // not yet a Class relation, just a string
  guardianName    String
  guardianPhone   String
  guardianEmail   String?
  address         String?
  status          AdmissionStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model FeeStructure {
  id        String   @id @default(cuid())
  campusId  String   @default("default")
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  feeType   String   // e.g. "Tuition", "Transport"
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, classId, feeType])
}

model FeeVoucher {
  id         String    @id @default(cuid())
  campusId   String    @default("default")
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  month      Int       // 1–12
  year       Int
  totalAmount Float
  isPaid     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  payments   Payment[]

  @@unique([campusId, studentId, month, year])
}

model Payment {
  id          String    @id @default(cuid())
  campusId    String    @default("default")
  voucherId   String
  voucher     FeeVoucher @relation(fields: [voucherId], references: [id])
  amount      Float
  method      String    @default("Cash") // Cash, Online, etc.
  receivedBy  String?   // user ID maybe later
  paidAt      DateTime  @default(now())
}